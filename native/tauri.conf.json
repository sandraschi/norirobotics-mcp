{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nori Robotics MCP",
  "version": "1.0.0",
  "identifier": "com.sandraschi.norirobotics-mcp",
  "build": {
    "frontendDist": "../web_sota/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nori Robotics MCP — A3 Control",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:11970 ws://127.0.0.1:11970; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: http://127.0.0.1:11970 https://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/norirobotics-mcp-backend.exe",
      "resources/.env.example"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "process": {
      "all": true
    }
  }
}
