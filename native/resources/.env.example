# NORI_MCP_HOST=127.0.0.1
# NORI_MCP_PORT=11970

# Real robot (WebRTC + Supabase Realtime signaling). Leave unset to use
# nori_sdk's own mock_session() — no physical A3 unit required for dev/CI.
# Nori A3 ships Fall 2026; there is nothing to point this at yet unless you
# have an early unit.
# NORI_MCP_SUPABASE_URL=https://xxxx.supabase.co
# NORI_MCP_SUPABASE_ANON_KEY=
# NORI_MCP_ROBOT_ROOM=NORI-A3-0001
# NORI_MCP_USER_EMAIL=
# NORI_MCP_USER_PASSWORD=

# NORI_MCP_CONNECT_TIMEOUT_S=15.0
